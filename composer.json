{
    "name": "gtcrais/hr-einvoicing",
    "description": "Croatian e-invoices (Fiskalizacija 2.0) for Laravel: UBL 2.1 documents under the HR CIUS 2025, sent through Moj-eRačun or ePoslovanje",
    "keywords": ["laravel", "e-invoice", "einvoicing", "e-invoicing", "e-račun", "eracun", "UBL", "EN 16931", "HR CIUS", "Moj-eRačun", "ePoslovanje", "fiskalizacija"],
    "authors": [
        {
            "name": "Tomislav Modrić",
            "email": "tomislav@tmweb.dev"
        }
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "GTCrais\\HrEInvoicing\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GTCrais\\HrEInvoicing\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GTCrais\\HrEInvoicing\\HrEInvoicingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
